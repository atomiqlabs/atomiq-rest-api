# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Storage Configuration
STORAGE_TYPE=sqlite
STORAGE_PATH=./data/swaps.db

# Atomiq SDK Configuration
ATOMIQ_NETWORK=mainnet
LP_DISCOVERY_URL=https://raw.githubusercontent.com/AtomiqLabs/atomiq-lp-list/main/lp-list.json

# Chain RPC Endpoints
STARKNET_RPC=http://localhost:5050
SOLANA_RPC=http://localhost:8899
BITCOIN_RPC=http://user:password@localhost:18332

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Rate Limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
