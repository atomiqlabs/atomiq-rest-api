{
  "name": "@atomiqlabs/rest-api",
  "version": "0.1.0",
  "description": "REST API middleware for Atomiq SDK - enables thin client integrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test dist/test/**/*.test.js",
    "test:watch": "node --test --watch dist/test/**/*.test.js",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "atomiq",
    "cross-chain",
    "swap",
    "bitcoin",
    "lightning",
    "solana",
    "starknet",
    "rest-api"
  ],
  "author": "Atomiq Labs",
  "license": "ISC",
  "dependencies": {
    "@atomiqlabs/sdk": "^7.0.0",
    "@atomiqlabs/storage-sqlite": "^4.0.0",
    "@atomiqlabs/chain-starknet": "^7.0.1",
    "@atomiqlabs/chain-solana": "^12.0.0",
    "@solana/web3.js": "^1.98.2",
    "starknet": "^8.5.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
